# Copiar este archivo como .env y ajustar los valores.

# ---- Conexion a SQL Server (comun a los tres nodos) ----
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_TRUSTED_CONNECTION=yes
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT=5

# ---- Nodo 1 ----
NODO1_DB=Biblioteca1DB
NODO1_HOST=127.0.0.1
NODO1_PORT=50051

# ---- Nodo 2 ----
NODO2_DB=Biblioteca2DB
NODO2_HOST=127.0.0.1
NODO2_PORT=50052

# ---- Nodo 3 ----
NODO3_DB=Biblioteca3DB
NODO3_HOST=127.0.0.1
NODO3_PORT=50053

# ---- Reglas de negocio ----
DIAS_PRESTAMO=15
