# ============================================================
#  Configuracion local del proyecto
# ============================================================
#  Copia este archivo como .env y ajusta los valores a tu equipo.
#  El archivo .env esta excluido del repositorio a proposito: cada
#  integrante tiene su propia instancia de SQL Server y sus propias
#  credenciales, y esos datos no deben publicarse.
#
#      copy .env.example .env        (Windows)
#      cp .env.example .env          (Linux o macOS)
#
#  Si algo falla en la conexion, ejecuta:
#      python herramientas/diagnostico.py
#  Esa herramienta prueba las combinaciones posibles de controlador y
#  servidor, y dice exactamente que valores poner aqui.
# ============================================================


# --- Conexion a SQL Server ----------------------------------
# Controlador ODBC instalado. Comprueba cual tienes en
# "Orígenes de datos ODBC (64 bits)" de Windows.
DB_DRIVER=ODBC Driver 17 for SQL Server

# Nombre de la instancia. Los valores mas comunes son:
#   localhost\SQLEXPRESS     instalacion tipica de SQL Server Express
#   localhost                instancia por defecto
#   NOMBRE-PC\SQLEXPRESS     si la instancia no es local
DB_SERVER=localhost\SQLEXPRESS

# Autenticacion de Windows (true) o de SQL Server (false).
DB_TRUSTED_CONNECTION=true

# Solo se usan cuando DB_TRUSTED_CONNECTION=false.
# Nunca subas este archivo con credenciales reales escritas aqui.
DB_USER=
DB_PASSWORD=

# Cifrado de la conexion. Con ODBC Driver 18 suele hacer falta
# dejar DB_TRUST_SERVER_CERTIFICATE en true para desarrollo local.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Segundos de espera al abrir la conexion.
DB_TIMEOUT=5


# --- Bases de datos de cada nodo ----------------------------
NODO1_DB=Biblioteca1DB
NODO2_DB=Biblioteca2DB
NODO3_DB=Biblioteca3DB


# --- Direcciones de los servidores gRPC ---------------------
# Con los tres nodos en el mismo equipo, deja 127.0.0.1.
# Si cada integrante levanta su nodo en su propia maquina, pon
# aqui la direccion IP correspondiente.
NODO1_HOST=127.0.0.1
NODO1_PORT=50051

NODO2_HOST=127.0.0.1
NODO2_PORT=50052

NODO3_HOST=127.0.0.1
NODO3_PORT=50053


# --- Reglas de negocio --------------------------------------
# Dias que dura un prestamo por defecto.
DIAS_PRESTAMO=15
